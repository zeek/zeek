# See the file "COPYING" in the main distribution directory for copyright.

module RESP;

import Redis;

import spicy;

# Maximum number of aggregate child values retained for one top-level RESP
# value. Allow configuring the limit via Zeek, but use the default if building
# separately.
@if HAVE_ZEEK
import zeek;
global _max_aggregate_elements: optional<uint64>; # appease spicy-format with a comment
public function max_aggregate_elements(): uint64 {
    if (!_max_aggregate_elements)
        _max_aggregate_elements = zeek::get_count("Redis::max_aggregate_elements");

    return *_max_aggregate_elements;
}
@else
public function max_aggregate_elements(): uint64 {
    return 20000;
}
@endif

# Maximum size for parsing of certain fields. By restricting this we avoid
# exhausting main memory.
public const MAX_SIZE = 1024 * 1024;
const MAX_RECURSION_DEPTH = 20;

function reserve_elements(elements_seen: uint64&, count: uint64): bool {
    local limit = max_aggregate_elements();
    if (limit == 0)
        return True;

    if (*elements_seen > limit || count > limit - *elements_seen)
        throw "too many elements %s > %s" % (*elements_seen + count, limit);

    *elements_seen += count;
    return True;
}

function element_count(count: int64): uint64 {
    if (count < 0)
        return 0;

    return uint64(count);
}

public type ClientMessages = unit {
    # The context here refers to whether we saw client data first. It is a one-time switch,
    # either we have seen client data or not.
    %context = bool;
    on %init {
        *self.context() = True;
    }
    : ClientData[];
};

public type ServerMessages = unit {
    %context = bool;
    on %init {
        if (!*self.context()) {
            throw "Server responses must come after a client request is seen";
        }
    }
    : (ServerData &synchronize)[];
};

public type ClientData = unit {
    on %init() {
        self.start = self.input();
    }

    # Clients can only be an array or inline
    ty: uint8 &convert=DataType($$) {
        if (self.ty != DataType::ARRAY) {
            # This is inline, so we need to reparse `ty`
            self.set_input(self.start);
        }
    }
    if (self.ty == DataType::ARRAY) {
        multibulk: BulkStringArray;
    } else {
        inline: RedisBytes &max-size=1024;
    };

    var start: iterator<stream>;
    var command: Redis::Command;

    on %done {
        self.command = Redis::make_command(self);
    }
};

type BulkStringArray = unit {
    var elements_seen: uint64& = new uint64;
    num_elements: RedisBytes &convert=$$.to_int(10);
    : void &requires=(self.num_elements == -1 || (self.num_elements >= 0 && reserve_elements(self.elements_seen, uint64(self.num_elements))));
    elements: BulkStringWithTy[element_count(self.num_elements)];
};

type BulkStringWithTy = unit {
    # Need to consume the type here
    : uint8 &requires=$$ == '$';

    length: RedisBytes &convert=$$.to_int(10) &requires=self.length <= int64(MAX_SIZE);
    # NullBulkString is a BulkString with content unset
    content: bytes &size=uint64(self.length) if(self.length >= 0);

    # Consume last CLRF
    : skip RedisBytes;
};

public type ServerData = unit {
    %synchronize-after = b"\x0d\x0a";
    var depth: uint8& = new uint8;
    var elements_seen: uint64& = new uint64;
    data: Data(self.depth, self.elements_seen);

    var type_: Redis::ReplyType;
    on %done {
        self.type_ = Redis::classify(self);
    }
};

type Data = unit(depth: uint8&, elements_seen: uint64&) {
    %synchronize-after = b"\x0d\x0a";
    ty: uint8 &convert=DataType($$);

    # Attributes are special, they precede the actual data
    if (self.ty == DataType::ATTRIBUTE) {
        attributes: Map(depth, elements_seen);
        : uint8 &convert=DataType($$) {
            self.ty = $$;
        }
    };

    switch (self.ty) {
        DataType::SIMPLE_STRING -> simple_string: SimpleString(False);
        DataType::SIMPLE_ERROR -> simple_error: SimpleString(True);
        DataType::INTEGER -> integer: Integer;
        DataType::BULK_STRING -> bulk_string: BulkString(False);
        DataType::ARRAY -> array: Array(depth, elements_seen);
        DataType::NULL -> null: Null_;
        DataType::BOOLEAN -> boolean: Boolean;
        DataType::DOUBLE -> double: Double;
        DataType::BIG_NUM -> big_num: BigNum;
        DataType::BULK_ERROR -> bulk_error: BulkString(True);
        # This can be a different type, but the docs also say:
        # "Some client libraries may ignore the difference between this type and the string type"
        # It just includes the encoding first in the content
        DataType::VERBATIM_STRING -> verbatim_string: BulkString(False);
        DataType::MAP -> map_: Map(depth, elements_seen);
        DataType::SET -> set_: Set(depth, elements_seen);
        # "Push events are encoded similarly to arrays, differing only in their
        # first byte"
        DataType::PUSH -> push: Array(depth, elements_seen);
    };

    on %init {
        depth++;
        if (*depth > MAX_RECURSION_DEPTH)
            throw "exceeded max recursion depth";
    }

    on %done {
        depth--;
    }
};

type DataType = enum {
    SIMPLE_STRING = '+',
    SIMPLE_ERROR = '-',
    INTEGER = ':',
    BULK_STRING = '$',
    ARRAY = '*',
    NULL = '_',
    BOOLEAN = '#',
    DOUBLE = ',',
    BIG_NUM = '(',
    BULK_ERROR = '!',
    VERBATIM_STRING = '=',
    MAP = '%',
    ATTRIBUTE = '|',
    SET = '~',
    PUSH = '>',
};

# Helper unit to extract bytes of some reasonable size so we do not exhaust mem.
type RedisBytes = unit {
    data: bytes &until=b"\x0d\x0a" &max-size=MAX_SIZE;
} &convert=self.data;

type SimpleString = unit(is_error: bool) {
    content: RedisBytes;
};

type Integer = unit {
    val: RedisBytes;
};

type BulkString = unit(is_error: bool) {
    length: RedisBytes &convert=$$.to_int(10) &requires=self.length <= int64(MAX_SIZE);
    # NullBulkString is a BulkString with content unset
    content: bytes &size=uint64(self.length) if(self.length >= 0);

    # Consume last CLRF if not a null bulk string
    : skip RedisBytes if(self.length >= 0);
};

type Array = unit(depth: uint8&, elements_seen: uint64&) {
    num_elements: RedisBytes &convert=$$.to_int(10);
    : void &requires=(self.num_elements == -1 || (self.num_elements >= 0 && reserve_elements(elements_seen, uint64(self.num_elements))));
    # Null array is an array with elements unset. This is different from an empty array
    elements: Data(depth, elements_seen)[element_count(self.num_elements)];
};

type Null_ = unit {
    # Still must consume CLRF
    : skip RedisBytes;
};

type Boolean = unit {
    val: uint8 &convert=$$ == 't';
    : skip RedisBytes;
};

type Double = unit {
    val: RedisBytes;
};

type BigNum = unit {
    val: RedisBytes;
};

type Map = unit(depth: uint8&, elements_seen: uint64&) {
    num_elements: RedisBytes &convert=$$.to_uint(10);
    : void &requires=reserve_elements(elements_seen, self.num_elements);
    raw_data: Data(depth, elements_seen)[self.num_elements * 2];
};

type Set = unit(depth: uint8&, elements_seen: uint64&) {
    num_elements: RedisBytes &convert=$$.to_uint(10);
    : void &requires=reserve_elements(elements_seen, self.num_elements);
    elements: Data(depth, elements_seen)[self.num_elements];
};

on ServerData::%done {
    spicy::accept_input();
}
