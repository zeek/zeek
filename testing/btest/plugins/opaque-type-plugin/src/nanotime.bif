%%{
#include <zeek/util.h>
#include <zeek/RunState.h>

#include "NanoTime.h"
%%}

module GLOBAL;

## For now just returns a fixed value.
function nanotime%(%): any
	%{
    // time.time() from Python on Aug 4, 2026  1785856683.3503187
    uint64_t nanos = 1785856683350318700UL;
    return zeek::make_intrusive<btest::type::NanoTimeVal>(nanos);
	%}
