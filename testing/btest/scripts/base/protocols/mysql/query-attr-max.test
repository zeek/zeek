# @TEST-DOC: Check for an analyzer violation if the number of queries in COM_QUERY exceeds MySQL::max_com_query_attributes.
# @TEST-EXEC: zeek -b -C -r $TRACES/mysql/query-attr.pcap %INPUT
# @TEST-EXEC: btest-diff-cut -m uid history service conn.log
# @TEST-EXEC: btest-diff-cut -m mysql.log
# @TEST-EXEC: btest-diff-cut -m analyzer.log

@load base/protocols/conn
@load base/protocols/mysql

redef MySQL::max_com_query_attributes = 1;
